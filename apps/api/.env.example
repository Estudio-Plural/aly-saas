# API
API_PORT=8080
ROUTE_JWT_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (LLM + Embeddings)
OPENROUTER_API_KEY=
# Modelo de embeddings (opcional; 3072 dims y el MISMO que apps/web al indexar)
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large

# LangSmith (Observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aly-saas

# Telegram Error Notifications (optional)
TELEGRAM_ERROR_BOT_TOKEN=
TELEGRAM_ERROR_CHAT_ID=

# Supervisor de conversaciones (analiza las conversaciones inactivas)
# Token de POST /internal/supervise (Authorization: Bearer <token>). Vacío = endpoint cerrado (503).
SUPERVISOR_TOKEN=
# Minutos sin mensajes para considerar terminada una conversación
SUPERVISOR_IDLE_MINUTES=30
# Máximo de conversaciones analizadas por corrida (acota el costo de LLM)
SUPERVISOR_BATCH_LIMIT=20
# Corrida automática dentro del proceso cada N minutos (0 = desactivado)
SUPERVISOR_INTERVAL_MINUTES=0
# Modelo del analista: workspace_configs.model_preferences.supervisor → .chat → este
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Alertas HIGH por Telegram (solo workspace + conversación + regla + severidad,
# nunca texto de mensajes). Si faltan, usa TELEGRAM_ERROR_*; si tampoco, log.
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ALERTS_CHAT_ID=

# Operar: reporte semanal (cifras agregadas sin PII) — POST /internal/weekly-report
# (mismo SUPERVISOR_TOKEN) o revisión periódica cada N minutos (0 = desactivado).
# Idempotente: cada semana se manda una sola vez por workspace.
WEEKLY_REPORT_INTERVAL_MINUTES=0
# Zona horaria de los programas (semana lunes-domingo, día y hora de las cifras)
PROGRAM_TIMEZONE=America/Bogota
# Link al panel en el correo (opcional), ej. https://panel.plural.../
PANEL_URL=
# SMTP (correo del reporte semanal y alertas por correo del protocolo). Sin
# SMTP_HOST no se manda nada: el reporte queda para descargar desde Operar.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Plural <hola@estudio-plural.co>
