# API
API_PORT=8080
ROUTE_JWT_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (LLM + Embeddings)
OPENROUTER_API_KEY=
# Modelo de embeddings (opcional; 3072 dims y el MISMO que apps/web al indexar)
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large

# LangSmith (Observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aly-saas

# Telegram Error Notifications (optional)
TELEGRAM_ERROR_BOT_TOKEN=
TELEGRAM_ERROR_CHAT_ID=

# --- Canal WhatsApp (Meta Cloud API directo) — ver docs/whatsapp-conectar-numero.md ---
# Token del handshake GET /api/webhook/meta (el mismo que se pone en el panel de Meta)
META_VERIFY_TOKEN=
# App secret de CADA App de Meta que apunte a este webhook (se verifica contra todos)
META_APP_SECRET=
# META_APP_SECRET_OTRA_APP=
# Un token de Graph por número; el panel guarda SOLO el nombre de la variable
# (whatsapp_connections.token_env). Tiene que empezar con META_TOKEN_.
# META_TOKEN_MI_PROGRAMA=
# META_GRAPH_VERSION=v23.0
# Solo desarrollo: Graph falso local (nunca en producción)
# META_GRAPH_BASE_URL=http://localhost:8422
# WA_PIPELINE_TIMEOUT_MS=60000
# WA_DB_TIMEOUT_MS=5000
