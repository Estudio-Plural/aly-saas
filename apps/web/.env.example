# --- Funcionamiento local (requerido) ---

# Postgres local (creado con scripts/db-setup.sh)
DATABASE_URL=postgresql://localhost:5432/aly_saas

# LLM del chat vía OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Modelo por defecto (override por workspace en workspace_configs.model_preferences.chat)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Modelo de embeddings del RAG (opcional; debe ser de 3072 dims y el MISMO
# que usa el engine — apps/api lee esta misma variable)
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large

# Engine conversacional real (apps/api — bun run src/index.ts). Si no responde,
# el chat cae al camino legacy de una sola llamada LLM (lib/llm.ts).
ENGINE_URL=http://localhost:8080

# --- Producción / post-funding (todavía sin cablear) ---

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Backend API (apps/api — scaffold sin implementar)
NEXT_PUBLIC_API_URL=http://localhost:8080
